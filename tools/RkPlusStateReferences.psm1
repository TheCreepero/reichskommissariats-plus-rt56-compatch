function Get-RkPlusGeneratedMarker {
    param([string]$RelativePath)

    $script:GeneratedMarkerPrefix + ($RelativePath -replace '\\', '/') + '; edit the source, not this file.'
}

function Get-RkPlusStateFileTargets {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$ModRoot
    )

    $targets = [System.Collections.Generic.List[string]]::new()
    foreach ($relativePath in $script:StateFileTargets) {
        $targets.Add($relativePath)
    }
    $countryHistoryFolder = Join-Path $ModRoot "$($script:SourceFolderName)\history\countries"
    if (Test-Path -LiteralPath $countryHistoryFolder) {
        foreach ($file in @(Get-ChildItem -LiteralPath $countryHistoryFolder -Filter '*.txt' -File | Sort-Object Name)) {
            $targets.Add("history\countries\$($file.Name)")
        }
    }
    , $targets.ToArray()
}

function Resolve-RkPlusManagerRoot {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$ModRoot
    )

    $treeCandidate = [System.IO.Path]::GetFullPath((Join-Path $ModRoot '..\..'))
    if (Test-Path -LiteralPath (Join-Path $treeCandidate 'Scripts\Vanilla\Get-HoiState.ps1')) {
        return $treeCandidate
    }
    $pointerPaths = @(
        (Join-Path $HOME '.claude\skills\hoi4-modding-knowledge\manager-root.txt'),
        (Join-Path $HOME '.gemini\config\skills\hoi4-modding-knowledge\manager-root.txt')
    )
    foreach ($pointerPath in $pointerPaths) {
        if (-not (Test-Path -LiteralPath $pointerPath)) {
            continue
        }
        $managerRoot = [System.IO.File]::ReadAllText($pointerPath).Trim()
        if (Test-Path -LiteralPath (Join-Path $managerRoot 'Scripts\Vanilla\Get-HoiState.ps1')) {
            return $managerRoot
        }
    }
    return $null
}

function Resolve-RkPlusFrozenRoot {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$ManagerRoot
    )

    $getHoiMod = Join-Path $ManagerRoot 'Scripts\Vanilla\Get-HoiMod.ps1'
    $candidates = @(& $getHoiMod -Name $script:RkPlusWorkshopId -PassThru | Where-Object { $_.Path -and (Test-Path -LiteralPath $_.Path) })
    $frozen = @($candidates | Where-Object { (Split-Path -Leaf $_.Path) -like 'frozen_*' })
    if ($frozen.Count -gt 0) {
        return $frozen[0].Path
    }
    if ($candidates.Count -gt 0) {
        return $candidates[0].Path
    }
    return $null
}

function ConvertTo-RkPlusIntArray {
    param($Value)

    if ($null -eq $Value) {
        return , @()
    }
    if ($Value.PSObject.Properties['value'] -and -not ($Value -is [array])) {
        $Value = $Value.value
    }
    , @($Value | ForEach-Object { [int]$_ })
}

function Get-RkPlusStateTable {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$ManagerRoot,

        [Parameter()]
        [string]$Mod
    )

    $getHoiState = Join-Path $ManagerRoot 'Scripts\Vanilla\Get-HoiState.ps1'
    $states = if ($Mod) {
        @(& $getHoiState -Name '*' -PassThru -Limit 5000 -Mod $Mod)
    } else {
        @(& $getHoiState -Name '*' -PassThru -Limit 5000)
    }
    $table = @{}
    foreach ($state in $states) {
        $victoryPoints = @{}
        if ($state.VictoryPoints) {
            foreach ($entry in $state.VictoryPoints.GetEnumerator()) {
                $victoryPoints[[int]$entry.Key] = [double]$entry.Value
            }
        }
        $table[[int]$state.Id] = [pscustomobject]@{
            Id            = [int]$state.Id
            Name          = [string]$state.Name
            Owner         = [string]$state.Owner
            Provinces     = (ConvertTo-RkPlusIntArray $state.ProvinceIds)
            VictoryPoints = $victoryPoints
        }
    }
    $table
}

function Get-RkPlusProvinceOwners {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [hashtable]$StateTable
    )

    $owners = @{}
    foreach ($state in $StateTable.Values) {
        foreach ($province in $state.Provinces) {
            $owners[$province] = $state.Id
        }
    }
    $owners
}

function Get-RkPlusLandProvinces {
    param([string]$ManagerRoot, [string]$Mod)

    $getHoiProvinceMap = Join-Path $ManagerRoot 'Scripts\Vanilla\Get-HoiProvinceMap.ps1'
    $infoArguments = @{ Mode = 'Info' }
    if ($Mod) {
        $infoArguments['Mod'] = $Mod
    }
    $infoText = (& $getHoiProvinceMap @infoArguments) -join "`n"
    $provinceCount = [int]([regex]::Match($infoText, '(\d+) province\(s\)').Groups[1].Value)
    $tableArguments = @{ Mode = 'Table'; Province = ((1..($provinceCount - 1)) -join ','); PassThru = $true }
    if ($Mod) {
        $tableArguments['Mod'] = $Mod
    }
    $land = @{}
    foreach ($row in @(& $getHoiProvinceMap @tableArguments)) {
        if ($row.Type -eq 'land') {
            $land[[int]$row.Province] = [pscustomobject]@{ X = [double]$row.CentroidX; Y = [double]$row.CentroidY }
        }
    }
    $land
}

function New-RkPlusCentroidGrid {
    param([hashtable]$Provinces, [int]$CellSize)

    $grid = @{}
    foreach ($entry in $Provinces.GetEnumerator()) {
        $cell = "{0},{1}" -f [Math]::Floor($entry.Value.X / $CellSize), [Math]::Floor($entry.Value.Y / $CellSize)
        if (-not $grid.ContainsKey($cell)) {
            $grid[$cell] = [System.Collections.Generic.List[int]]::new()
        }
        $grid[$cell].Add($entry.Key)
    }
    $grid
}

function Find-RkPlusNearestProvince {
    param($Point, [hashtable]$Provinces, [hashtable]$Grid, [int]$CellSize)

    $cellX = [Math]::Floor($Point.X / $CellSize)
    $cellY = [Math]::Floor($Point.Y / $CellSize)
    $best = $null
    $bestDistance = [double]::MaxValue
    for ($ring = 0; $ring -le 8; $ring++) {
        for ($dx = - $ring; $dx -le $ring; $dx++) {
            for ($dy = - $ring; $dy -le $ring; $dy++) {
                if ([Math]::Max([Math]::Abs($dx), [Math]::Abs($dy)) -ne $ring) {
                    continue
                }
                $cell = "{0},{1}" -f ($cellX + $dx), ($cellY + $dy)
                if (-not $Grid.ContainsKey($cell)) {
                    continue
                }
                foreach ($province in $Grid[$cell]) {
                    $candidate = $Provinces[$province]
                    $distance = ($candidate.X - $Point.X) * ($candidate.X - $Point.X) + ($candidate.Y - $Point.Y) * ($candidate.Y - $Point.Y)
                    if ($distance -lt $bestDistance) {
                        $bestDistance = $distance
                        $best = $province
                    }
                }
            }
        }
        if ($null -ne $best -and [Math]::Sqrt($bestDistance) -le $ring * $CellSize) {
            break
        }
    }
    $best
}

function Get-RkPlusProvinceTranslation {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$ManagerRoot,

        [Parameter(Mandatory)]
        [string]$MapMod,

        [Parameter()]
        [double]$SameProvinceDistance = 8
    )

    $vanillaLand = Get-RkPlusLandProvinces -ManagerRoot $ManagerRoot
    $mapLand = Get-RkPlusLandProvinces -ManagerRoot $ManagerRoot -Mod $MapMod
    $cellSize = 32
    $translate = {
        param([hashtable]$From, [hashtable]$To)

        $grid = New-RkPlusCentroidGrid -Provinces $To -CellSize $cellSize
        $result = @{}
        $moved = 0
        $unmatched = 0
        foreach ($entry in $From.GetEnumerator()) {
            $province = $entry.Key
            $point = $entry.Value
            if ($To.ContainsKey($province)) {
                $same = $To[$province]
                if ([Math]::Sqrt(($same.X - $point.X) * ($same.X - $point.X) + ($same.Y - $point.Y) * ($same.Y - $point.Y)) -le $SameProvinceDistance) {
                    $result[$province] = $province
                    continue
                }
            }
            $moved++
            $nearest = Find-RkPlusNearestProvince -Point $point -Provinces $To -Grid $grid -CellSize $cellSize
            if ($null -eq $nearest) {
                $unmatched++
            }
            $result[$province] = $nearest
        }
        [pscustomobject]@{ Map = $result; Moved = $moved; Unmatched = $unmatched }
    }
    $forward = & $translate $vanillaLand $mapLand
    $reverse = & $translate $mapLand $vanillaLand
    [pscustomobject]@{
        Forward          = $forward.Map
        Reverse          = $reverse.Map
        MovedForward     = $forward.Moved
        MovedReverse     = $reverse.Moved
        UnmatchedForward = $forward.Unmatched
        UnmatchedReverse = $reverse.Unmatched
    }
}

function Get-RkPlusVanillaFootprints {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [hashtable]$VanillaStates,

        [Parameter(Mandatory)]
        [hashtable]$MapStates,

        [Parameter(Mandatory)]
        $Translation
    )

    $vanillaOwnerOfProvince = Get-RkPlusProvinceOwners -StateTable $VanillaStates
    $footprints = @{}
    foreach ($vanillaId in $VanillaStates.Keys) {
        $footprints[$vanillaId] = [System.Collections.Generic.HashSet[int]]::new()
    }
    foreach ($state in $MapStates.Values) {
        foreach ($province in $state.Provinces) {
            if ($Translation.Reverse.ContainsKey($province)) {
                $vanillaProvince = $Translation.Reverse[$province]
                if ($null -ne $vanillaProvince -and $vanillaOwnerOfProvince.ContainsKey($vanillaProvince)) {
                    [void]$footprints[$vanillaOwnerOfProvince[$vanillaProvince]].Add($province)
                }
            }
        }
    }
    foreach ($state in $VanillaStates.Values) {
        foreach ($province in $state.Provinces) {
            if ($Translation.Forward.ContainsKey($province) -and $null -ne $Translation.Forward[$province]) {
                [void]$footprints[$state.Id].Add($Translation.Forward[$province])
            }
        }
    }
    $footprints
}

function New-RkPlusFrame {
    param($Key, $KeyToken, [int]$OpenIndex, $Parent, [int]$Depth)

    $ordinal = 0
    if ($Parent) {
        $ordinal = 1 + [int]$Parent.ChildKeyCounts[$Key]
        $Parent.ChildKeyCounts[$Key] = $ordinal
    }
    [pscustomobject]@{
        Key            = $Key
        KeyIndex       = if ($KeyToken) { $KeyToken.Index } else { $OpenIndex }
        OpenIndex      = $OpenIndex
        CloseEnd       = -1
        Id             = $null
        Parent         = $Parent
        Depth          = $Depth
        Ordinal        = $ordinal
        ChildKeyCounts = @{}
    }
}

function Get-RkPlusStateReferences {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [AllowEmptyString()]
        [string]$Text,

        [Parameter()]
        [int]$MaxStateId = 1143
    )

    $references = [System.Collections.Generic.List[object]]::new()
    $provinces = [System.Collections.Generic.List[object]]::new()
    $unclassified = [System.Collections.Generic.List[object]]::new()
    $root = New-RkPlusFrame -Key '' -KeyToken $null -OpenIndex 0 -Parent $null -Depth -1
    $current = $root
    $previous = $null
    $beforePrevious = $null

    foreach ($token in $script:TokenPattern.Matches($Text)) {
        $value = $token.Value
        if ($value[0] -eq '#') {
            continue
        }
        if ($value -eq '{') {
            $keyToken = if ($previous -and $previous.Value -eq '=' -and $beforePrevious) { $beforePrevious } else { $null }
            $key = if ($keyToken) { $keyToken.Value } else { '' }
            $frame = New-RkPlusFrame -Key $key -KeyToken $keyToken -OpenIndex $token.Index -Parent $current -Depth ($current.Depth + 1)
            if ($keyToken -and $script:StateIdPattern.IsMatch($key) -and ($script:NonStateBlockParents -notcontains $current.Key)) {
                $references.Add([pscustomobject]@{
                    Kind        = 'Scope'
                    Key         = ''
                    Id          = [int]$key
                    KeyIndex    = $keyToken.Index
                    KeyLength   = $keyToken.Length
                    ValueIndex  = $keyToken.Index
                    ValueLength = $keyToken.Length
                    Frame       = $frame
                    Parent      = $current
                })
            }
            $current = $frame
        } elseif ($value -eq '}') {
            $current.CloseEnd = $token.Index + 1
            if ($current.Parent) {
                $current = $current.Parent
            }
        } elseif ($previous -and $previous.Value -eq '=' -and $beforePrevious) {
            $key = $beforePrevious.Value
            if ($key -eq 'id' -and $null -eq $current.Id) {
                $current.Id = $value.Trim('"')
            }
            if (($script:ProvinceValueKeys -contains $key -or ($key -eq 'id' -and $current.Key -eq 'set_province_name')) -and $script:ProvinceIdPattern.IsMatch($value)) {
                $provinces.Add([pscustomobject]@{ Key = $key; Id = [int]$value; ValueIndex = $token.Index; ValueLength = $token.Length; Parent = $current })
            } elseif ($script:StateIdPattern.IsMatch($value)) {
                if ($script:StateValueKeys -contains $key) {
                    $references.Add([pscustomobject]@{
                        Kind        = 'Key'
                        Key         = $key
                        Id          = [int]$value
                        KeyIndex    = $beforePrevious.Index
                        KeyLength   = $beforePrevious.Length
                        ValueIndex  = $token.Index
                        ValueLength = $token.Length
                        Frame       = $null
                        Parent      = $current
                    })
                } elseif ($key -match 'state|capital' -and ($script:NumericKeysNamingStatesThatAreAmounts -notcontains $key) -and [int]$value -ge 1 -and [int]$value -le $MaxStateId) {
                    $unclassified.Add([pscustomobject]@{ Key = $key; Id = [int]$value; Index = $token.Index; Parent = $current.Key })
                }
            }
        }
        $beforePrevious = $previous
        $previous = $token
    }

    [pscustomobject]@{
        References   = $references.ToArray()
        Provinces    = $provinces.ToArray()
        Unclassified = $unclassified.ToArray()
    }
}

function Get-RkPlusFrameChain {
    param($Frame)

    $chain = [System.Collections.Generic.List[object]]::new()
    $walker = $Frame
    while ($walker -and $walker.Depth -ge 0) {
        $chain.Insert(0, $walker)
        $walker = $walker.Parent
    }
    , $chain.ToArray()
}

function Get-RkPlusDefinitionKey {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        $Frame,

        [Parameter(Mandatory)]
        [string]$RelativePath,

        [Parameter()]
        [string]$FallbackSection = ''
    )

    $chain = Get-RkPlusFrameChain -Frame $Frame
    if ($RelativePath -like 'history\*' -or $chain.Count -eq 0) {
        return [pscustomobject]@{ Definition = '(file)'; Section = if ($chain.Count) { $chain[0].Key } else { $FallbackSection } }
    }
    $definitionDepth = 0
    if ($RelativePath -like 'common\decisions\*' -and $chain.Count -ge 2) {
        $definitionDepth = 1
    } elseif ($RelativePath -like 'common\national_focus\*') {
        for ($index = $chain.Count - 1; $index -ge 0; $index--) {
            if (@('focus', 'shared_focus', 'joint_focus') -contains $chain[$index].Key) {
                $definitionDepth = $index
                break
            }
        }
    }
    $definitionFrame = $chain[$definitionDepth]
    $name = if ($definitionFrame.Id) { "$($definitionFrame.Key) $($definitionFrame.Id)" } else { $definitionFrame.Key }
    $section = '(body)'
    if ($chain.Count -gt $definitionDepth + 1) {
        $sectionFrame = $chain[$definitionDepth + 1]
        $section = if ($sectionFrame.Ordinal -gt 1 -or $sectionFrame.Parent.ChildKeyCounts[$sectionFrame.Key] -gt 1) { "$($sectionFrame.Key) $($sectionFrame.Ordinal)" } else { $sectionFrame.Key }
        for ($index = $chain.Count - 1; $index -gt $definitionDepth + 1; $index--) {
            if ($script:CountryTagPattern.IsMatch($chain[$index].Key)) {
                $section = "$section > $($chain[$index].Key)"
                break
            }
        }
    }
    [pscustomobject]@{ Definition = $name; Section = $section }
}

function Read-RkPlusStateMap {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$Path
    )

    $document = [System.IO.File]::ReadAllText($Path) | ConvertFrom-Json
    $entries = $document.states
    if ($entries.PSObject.Properties['value'] -and -not ($entries -is [array])) {
        $entries = $entries.value
    }
    $targets = @{}
    $capitals = @{}
    $pieceProvinces = @{}
    foreach ($entry in $entries) {
        $vanillaId = [int]$entry.id
        $targets[$vanillaId] = (ConvertTo-RkPlusIntArray $entry.targets)
        $capitals[$vanillaId] = if ($entry.PSObject.Properties['capital']) { [int]$entry.capital } else { $targets[$vanillaId][0] }
        if ($entry.PSObject.Properties['provinces']) {
            $pieces = @{}
            $index = 0
            foreach ($pieceList in @($entry.provinces)) {
                $set = [System.Collections.Generic.HashSet[int]]::new()
                foreach ($province in (ConvertTo-RkPlusIntArray $pieceList)) {
                    [void]$set.Add($province)
                }
                $pieces[$targets[$vanillaId][$index]] = $set
                $index++
            }
            $pieceProvinces[$vanillaId] = $pieces
        }
    }
    $moved = @{}
    if ($document.PSObject.Properties['movedProvinces']) {
        foreach ($property in $document.movedProvinces.PSObject.Properties) {
            $moved[[int]$property.Name] = [int]$property.Value
        }
    }
    [pscustomobject]@{
        Targets        = $targets
        Capitals       = $capitals
        PieceProvinces = $pieceProvinces
        MovedProvinces = $moved
        MapStateCount  = [int]$document.source.mapStates
    }
}

function Get-RkPlusLineLayout {
    param([string]$Text, [int]$Index, [string]$NewLine)

    $lineStart = if ($Index -eq 0) { 0 } else { $Text.LastIndexOf("`n", $Index - 1) + 1 }
    $leading = $Text.Substring($lineStart, $Index - $lineStart)
    if ($leading.Trim().Length -eq 0) {
        return $NewLine + $leading
    }
    return ' '
}

function Test-RkPlusSingleValuedReference {
    param($Reference)

    $Reference.Kind -eq 'Key' -and ($Reference.Key -eq 'capital' -or $script:AnchorOnlyParents -contains $Reference.Parent.Key)
}

function Test-RkPlusRepeatableBody {
    param([string]$Text, $Frame)

    $previous = $null
    foreach ($token in $script:TokenPattern.Matches($Text.Substring($Frame.OpenIndex, $Frame.CloseEnd - $Frame.OpenIndex))) {
        if ($token.Value[0] -eq '#') {
            continue
        }
        if ($token.Value -eq '=' -and $previous -and $previous -notmatch '^[\{\}=]$') {
            if ($script:RepeatableScopeKeys -notcontains $previous -and $previous -notmatch '_trigger$' -and -not $script:CountryTagPattern.IsMatch($previous)) {
                return $false
            }
        }
        $previous = $token.Value
    }
    return $true
}

function Get-RkPlusMultiTargetMode {
    param($Reference, [string]$Text)

    $parentKey = $Reference.Parent.Key
    if ($Reference.Kind -eq 'Scope') {
        if (-not (Test-RkPlusRepeatableBody -Text $Text -Frame $Reference.Frame)) {
            return 'OnePiece'
        }
        if ($parentKey -eq 'OR' -or $parentKey -eq 'NOT') {
            return 'CloneAnd'
        }
        return 'Clone'
    }
    if (Test-RkPlusSingleValuedReference -Reference $Reference) {
        return 'Anchor'
    }
    if ($Reference.Key -eq 'state') {
        if ($script:StateListParents -contains $parentKey) {
            return 'Repeat'
        }
        if ($script:StateConditionParents -contains $parentKey) {
            return 'WrapOr'
        }
        return 'Stop'
    }
    if ($script:EffectKeys -contains $Reference.Key) {
        return 'Repeat'
    }
    if ($script:ControlKeys -contains $Reference.Key) {
        if ($parentKey -eq 'OR' -or $parentKey -eq 'NOT') {
            return 'WrapAnd'
        }
        return 'Repeat'
    }
    return 'Stop'
}

function Test-RkPlusInside {
    param([int]$Index, $Frame)

    $Index -gt $Frame.OpenIndex -and $Index -lt $Frame.CloseEnd
}

function Convert-RkPlusStateText {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [AllowEmptyString()]
        [string]$Text,

        [Parameter(Mandatory)]
        $StateMap
    )

    $newLine = if ($Text.Contains("`r`n")) { "`r`n" } else { "`n" }
    $parsed = Get-RkPlusStateReferences -Text $Text -MaxStateId $StateMap.MapStateCount
    $edits = [System.Collections.Generic.List[object]]::new()
    $stops = [System.Collections.Generic.List[object]]::new()
    $onePieceNotes = [System.Collections.Generic.List[object]]::new()
    $changedReferenceCount = 0

    $targetsOf = {
        param([int]$StateId)
        if ($StateId -le $script:VanillaStateCount) { , $StateMap.Targets[$StateId] } else { , @($StateId) }
    }
    $seenByParent = @{}
    $seenOf = {
        param($Parent)
        $parentId = [System.Runtime.CompilerServices.RuntimeHelpers]::GetHashCode($Parent)
        if (-not $seenByParent.ContainsKey($parentId)) {
            $seenByParent[$parentId] = [System.Collections.Generic.HashSet[string]]::new()
        }
        , $seenByParent[$parentId]
    }
    foreach ($reference in $parsed.References) {
        if ($reference.Kind -ne 'Key' -or ($reference.Id -le $script:VanillaStateCount -and -not $StateMap.Targets.ContainsKey($reference.Id))) {
            continue
        }
        $targets = & $targetsOf $reference.Id
        if ($targets.Count -eq 1 -and $targets[0] -eq $reference.Id) {
            [void](& $seenOf $reference.Parent).Add("$($reference.Key)|$($reference.Id)")
        }
    }

    foreach ($province in $parsed.Provinces) {
        if ($StateMap.MovedProvinces.ContainsKey($province.Id)) {
            $edits.Add([pscustomobject]@{ Start = $province.ValueIndex; End = $province.ValueIndex + $province.ValueLength; Mode = 'Text'; Replacement = [string]$StateMap.MovedProvinces[$province.Id] })
        }
    }

    foreach ($reference in ($parsed.References | Sort-Object KeyIndex)) {
        if ($reference.Id -le $script:VanillaStateCount -and -not $StateMap.Targets.ContainsKey($reference.Id)) {
            $stops.Add([pscustomobject]@{ Index = $reference.KeyIndex; Reason = "state $($reference.Id) has no entry in the state map" })
            continue
        }
        $targets = & $targetsOf $reference.Id
        if ((Test-RkPlusSingleValuedReference -Reference $reference) -and $reference.Id -le $script:VanillaStateCount) {
            $targets = @($StateMap.Capitals[$reference.Id])
        }
        if ($targets.Count -eq 1 -and $targets[0] -eq $reference.Id) {
            continue
        }
        $mode = if ($targets.Count -gt 1) { Get-RkPlusMultiTargetMode -Reference $reference -Text $Text } else { 'Single' }
        if ($mode -eq 'Stop') {
            $stops.Add([pscustomobject]@{ Index = $reference.KeyIndex; Reason = "state $($reference.Id) splits into $($targets -join ', ') but '$(if ($reference.Kind -eq 'Scope') { 'a scope block' } else { $reference.Key })' inside '$($reference.Parent.Key)' has no rule" })
            continue
        }
        if ($mode -eq 'Anchor') {
            $targets = @($targets[0])
        }
        if ($mode -eq 'OnePiece') {
            $chosen = $targets[0]
            $blockProvinces = @($parsed.Provinces | Where-Object { Test-RkPlusInside -Index $_.ValueIndex -Frame $reference.Frame } | ForEach-Object { if ($StateMap.MovedProvinces.ContainsKey($_.Id)) { $StateMap.MovedProvinces[$_.Id] } else { $_.Id } })
            if ($blockProvinces.Count -and $StateMap.PieceProvinces.ContainsKey($reference.Id)) {
                $pieces = $StateMap.PieceProvinces[$reference.Id]
                foreach ($candidate in $targets) {
                    if ($pieces.ContainsKey($candidate) -and @($blockProvinces | Where-Object { -not $pieces[$candidate].Contains($_) }).Count -eq 0) {
                        $chosen = $candidate
                        break
                    }
                }
            }
            $onePieceNotes.Add([pscustomobject]@{ Index = $reference.KeyIndex; StateId = $reference.Id; Chosen = $chosen; Targets = $targets })
            $targets = @($chosen)
        }
        if ($targets.Count -eq 1 -and $targets[0] -eq $reference.Id) {
            continue
        }
        if (@('WrapOr', 'WrapAnd') -contains $mode) {
            $edits.Add([pscustomobject]@{
                Start       = $reference.KeyIndex
                End         = $reference.ValueIndex + $reference.ValueLength
                Mode        = 'Text'
                Replacement = ('{0} = {{ {1} }}' -f $(if ($mode -eq 'WrapOr') { 'OR' } else { 'AND' }), (($targets | ForEach-Object { "$($reference.Key) = $_" }) -join ' '))
            })
            $changedReferenceCount++
            continue
        }

        $changedReferenceCount++
        $separator = Get-RkPlusLineLayout -Text $Text -Index $reference.KeyIndex -NewLine $newLine
        if ($reference.Kind -eq 'Scope') {
            $edits.Add([pscustomobject]@{
                Start     = $reference.KeyIndex
                End       = $reference.Frame.CloseEnd
                Mode      = if ($mode -eq 'CloneAnd') { 'CloneAnd' } else { 'Clone' }
                Targets   = $targets
                KeyLength = $reference.KeyLength
                Separator = $separator
            })
        } else {
            $seen = & $seenOf $reference.Parent
            $referenceKey = $reference.Key
            $freshTargets = @($targets | Where-Object { $seen.Add("$referenceKey|$_") })
            $prefix = $Text.Substring($reference.KeyIndex, $reference.ValueIndex - $reference.KeyIndex)
            $edits.Add([pscustomobject]@{
                Start       = $reference.KeyIndex
                End         = $reference.ValueIndex + $reference.ValueLength
                Mode        = 'Text'
                Replacement = (($freshTargets | ForEach-Object { "$prefix$_" }) -join $separator)
            })
        }
    }

    $orderedEdits = @($edits | Sort-Object Start, @{ Expression = { - $_.End } })
    $render = $null
    $render = {
        param([int]$From, [int]$To, [object[]]$Candidates)

        $builder = [System.Text.StringBuilder]::new()
        $cursor = $From
        $index = 0
        while ($index -lt $Candidates.Count) {
            $edit = $Candidates[$index]
            if ($edit.Start -lt $cursor -or $edit.End -gt $To) {
                $index++
                continue
            }
            [void]$builder.Append($Text, $cursor, $edit.Start - $cursor)
            $inner = [System.Collections.Generic.List[object]]::new()
            $next = $index + 1
            while ($next -lt $Candidates.Count -and $Candidates[$next].Start -lt $edit.End) {
                $inner.Add($Candidates[$next])
                $next++
            }
            if ($edit.Mode -eq 'Clone' -or $edit.Mode -eq 'CloneAnd') {
                $tail = & $render ($edit.Start + $edit.KeyLength) $edit.End $inner.ToArray()
                $copies = @($edit.Targets | ForEach-Object { "$_$tail" })
                if ($edit.Mode -eq 'CloneAnd') {
                    [void]$builder.Append('AND = { ' + ($copies -join ' ') + ' }')
                } else {
                    [void]$builder.Append(($copies -join $edit.Separator))
                }
            } else {
                [void]$builder.Append($edit.Replacement)
            }
            $cursor = $edit.End
            $index = $next
        }
        [void]$builder.Append($Text, $cursor, $To - $cursor)
        $builder.ToString()
    }

    [pscustomobject]@{
        Text                  = (& $render 0 $Text.Length $orderedEdits)
        ChangedReferenceCount = $changedReferenceCount
        Stops                 = $stops.ToArray()
        OnePiece              = $onePieceNotes.ToArray()
        Unclassified          = $parsed.Unclassified
    }
}

function Get-RkPlusLineNumber {
    param([string]$Text, [int]$Index)

    ([regex]::Matches($Text.Substring(0, [Math]::Min($Index, $Text.Length)), "`n")).Count + 1
}

